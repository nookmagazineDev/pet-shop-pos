# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit ไฟล์ .env ลง git
# ใช้ตัวอักษร a-z และตัวเลขเท่านั้น (ห้ามมีเครื่องหมายคำพูดหรือช่องว่าง)
# สร้างค่าสุ่มใน PowerShell:  -join (1..48 | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })

# รหัสผ่านผู้ดูแลฐานข้อมูล (postgres)
POSTGRES_PASSWORD=

# รหัสผ่านที่ PostgREST ใช้เชื่อมต่อฐานข้อมูล
AUTHENTICATOR_PASSWORD=

# กุญแจเซ็น token ล็อกอิน — อย่างน้อย 32 ตัวอักษร (แนะนำ 48)
JWT_SECRET=

# Token จาก Cloudflare Zero Trust → Networks → Tunnels (ดู docs/NAS_SETUP.md ขั้นที่ 4)
CLOUDFLARE_TUNNEL_TOKEN=
